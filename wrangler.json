{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nms-frigate-calc",
	"compatibility_date": "2026-10-08",
	"assets": {
		"directory": "dist",
		"not_found_handling": "404-page"
	},
	"vars": {},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
}
