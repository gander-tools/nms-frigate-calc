{
  "name": "nms-frigate-calc",
  "private": true,
  "version": "3.1.6",
  "type": "module",
  "scripts": {
    "dotenvx": "dotenvx",
    "dev": "dotenvx run -- vite",
    "build": "dotenvx run -- vue-tsc && dotenvx run -- vite build",
    "preview": "dotenvx run -- vite preview",
    "release": "release-it --only-version"
  },
  "release-it": {
    "git": {
      "requireBranch": "master"
    },
    "npm": {
      "publish": false,
      "ignoreVersion": true
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.0.0",
    "@sentry/vue": "^11.0.0",
    "bootstrap": "^5.3.3",
    "caniuse-lite": "^1.0.30001684",
    "highlight.run": "^10.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/bootstrap": "5.2.11",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "npm-run-all2": "9.0.4",
    "release-it": "21.1.2",
    "sass": "1.108.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vite-plugin-html-config": "2.0.2",
    "vite-plugin-pwa": "2.0.0",
    "vue-tsc": "3.3.14"
  }
}
